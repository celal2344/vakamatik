{
  "name": "@vakamatik/desktop",
  "productName": "Vakamatik",
  "version": "0.0.0-gate-4",
  "description": "Offline orthodontic case presentation builder",
  "author": "Vakamatik",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "dependencies": {
    "@vakamatik/case-store": "workspace:*",
    "@vakamatik/desktop-contract": "workspace:*",
    "@vakamatik/domain": "workspace:*",
    "@vakamatik/export-contract": "workspace:*",
    "@vakamatik/layout-engine": "workspace:*",
    "@vakamatik/media": "workspace:*",
    "@vakamatik/pptx-exporter": "workspace:*",
    "@vakamatik/preview": "workspace:*",
    "sharp": "0.34.4"
  },
  "scripts": {
    "dev": "pnpm build:main && pnpm build:preload && concurrently --kill-others --success first \"pnpm dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && cross-env VAKAMATIK_DEV_SERVER_URL=http://127.0.0.1:5173 electron-forge start\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.config.json --noEmit",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  }
}
